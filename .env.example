# Optional. Google Tag Manager container ID. Defaults to GTM-THTHFFN9 in src/config.ts.
PUBLIC_GTM_ID=
# Optional. Google Analytics 4 measurement ID (G-XXXXXXX). Leave empty to disable.
PUBLIC_GA_ID=
# Optional. Form endpoint (Formspree, Basin, Web3Forms...) that accepts a POST of the statement-analysis and agent forms.
PUBLIC_FORM_ENDPOINT=
# Optional. CallScaler dynamic number insertion snippet URL (script src). Leave empty until you have a number pool.
PUBLIC_CALLSCALER_SRC=
