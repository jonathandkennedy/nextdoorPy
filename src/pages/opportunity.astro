---
import Layout from '../layouts/Layout.astro';
import { site, tel } from '../config';
import '../styles/opportunity.css';
const smsBody = 'Hi, I am interested in the agent program.';
---
<Layout title="Become a Nextdoor Payments Agent: Residual Income Program" description="Independent merchant services agent program. Vested residuals from day one, up to 70% splits, free training, CRM and territory leads. No desk fees, no quotas." smsBody={smsBody}>
<section class="ahero">
  <div class="c">
    <div class="ahero-ct">
      <div class="ahero-text">
        <div class="tg rv">Now recruiting independent agents</div>
        <h1 class="rv d1">Build <em>Residual Income</em> That Pays You Every Single Month.</h1>
        <p class="sub rv d2"><strong>No degree required. No experience required. No desk fees. No quotas.</strong> Just a work ethic and the desire to build something that compounds every month you show up.</p>
        <p class="sub rv d2">Every merchant you sign pays you residuals <strong>for as long as they process cards.</strong> Your 50th merchant does not replace your first. It stacks on top. This is not a job. It is a portfolio.</p>
        <div class="chips rv d3">
          <span class="chip">&#x2705; Vested day one</span>
          <span class="chip">&#x1F4B0; Uncapped income</span>
          <span class="chip">&#x1F393; Free training</span>
          <span class="chip">&#x1F6AB; No contracts</span>
        </div>
        <a href="#apply" class="bp big rv d3" style="max-width:320px">Apply now &rarr;</a>
      </div>
      <div class="ahero-img rv d2">
        <img src="https://images.unsplash.com/photo-1521791136064-7986c2920216?w=900&q=80" alt="Agent shaking hands with a business owner" width="900" height="600" loading="eager">
      </div>
    </div>
  </div>
</section>

<section class="calc-section" id="calculator">
  <div class="c">
    <div class="calc-card rv">
      <h2>Residual income calculator</h2>
      <p class="calc-sub">See what your monthly income looks like as your portfolio grows.</p>
      <div class="calc-avg"><div class="num">$419.71</div><div class="lab">Average monthly residual per dual pricing merchant</div></div>
      <div class="slider-wrap">
        <label for="merchSlider">How many merchants in your portfolio?</label>
        <input type="range" id="merchSlider" min="1" max="100" value="10">
        <div class="slider-val" id="merchCount">10 merchants</div>
      </div>
      <div class="calc-result">
        <div class="res-label">Your monthly residual income</div>
        <div class="res-num" id="monthlyIncome">$4,197.10</div>
        <div class="res-year" id="yearlyIncome">$50,365.20 / year</div>
      </div>
      <p class="calc-note">Based on our average dual pricing merchant. Actual results vary by merchant volume and pricing. Residuals are vested from day one. You own your portfolio.</p>
    </div>
  </div>
</section>

<section class="spb"><div class="c"><h2 class="rv">Your residuals are vested from day one.</h2><p class="rv d1">From the moment you sign your first merchant, you own that income stream. Period.</p></div></section>

<section class="wyg">
  <div class="c">
    <div class="sh rv"><div class="sg">What you get</div><h2>Everything You Need to Close. We Provide It.</h2><p>This is not a rate sheet and a handshake. You get tools, training, leads and support to actually close deals and build a real book.</p></div>
    <div class="wyg-grid">
      <div class="wyg-card rv"><div class="wyg-icon">&#x1F4B5;</div><div><h3>Residual income from day one</h3><p>Every merchant pays you monthly for as long as they process. Vested immediately. No clawbacks. No vesting period.</p></div></div>
      <div class="wyg-card rv d1"><div class="wyg-icon">&#x1F4E6;</div><div><h3>Free equipment programs</h3><p>Dejavoo terminals, Clover, Exatouch. Free equipment programs so you never lose a deal over hardware cost.</p></div></div>
      <div class="wyg-card rv d2"><div class="wyg-icon">&#x1F517;</div><div><h3>Integrations and software</h3><p>QuickBooks, Shopify, WooCommerce, accept.blue gateway, Hyfin invoicing. A solution for every merchant type.</p></div></div>
      <div class="wyg-card rv"><div class="wyg-icon">&#x1F4E3;</div><div><h3>Marketing help</h3><p>White-labeled flyers, email sequences, lead magnets, and a marketing team that builds materials for you.</p></div></div>
      <div class="wyg-card rv d1"><div class="wyg-icon">&#x1F6E0;</div><div><h3>Tools built for agents</h3><p>CRM, deal pipeline tracking, digital merchant applications, residual reporting.</p></div></div>
      <div class="wyg-card rv d2"><div class="wyg-icon">&#x1F393;</div><div><h3>Learning center</h3><p>Full training on Heights Platform. Machine recognition, qualification, objection handling, product knowledge. Free.</p></div></div>
      <div class="wyg-card rv"><div class="wyg-icon">&#x1F3AF;</div><div><h3>Accountability coach</h3><p>Weekly coaching calls, deal review, and help closing. We close tough deals with you.</p></div></div>
      <div class="wyg-card rv d1"><div class="wyg-icon">&#x1F91D;</div><div><h3>White glove install</h3><p>We handle equipment programming, merchant boarding, staff training, and cutover. You sell, we install.</p></div></div>
      <div class="wyg-card rv d2"><div class="wyg-icon">&#x1F4DE;</div><div><h3>24-hour tech support</h3><p>In-house tech team. Your merchants get a real person, not a voicemail.</p></div></div>
    </div>
  </div>
</section>

<section class="crm-show">
  <div class="c">
    <div class="crm-ct">
      <div class="crm-text rv">
        <div class="sg">Your agent dashboard</div>
        <h2>A CRM Built for Payment Agents</h2>
        <p>No spreadsheets. No guessing where a deal is. Your dashboard shows your full pipeline, residual earnings, merchant portfolio and enrollment status in real time.</p>
        <ul class="crm-feats">
          <li>Track every deal from lead to installed</li>
          <li>Send merchant applications digitally with e-signature</li>
          <li>Watch residual income grow in real time</li>
          <li>Access white-labeled marketing materials</li>
          <li>Territory lead lists with business owner contact info</li>
        </ul>
      </div>
      <div class="crm-img rv d1"><img src="/images/crmmockup.jpg" alt="Nextdoor Payments agent CRM dashboard" loading="lazy"></div>
    </div>
  </div>
</section>

<section class="dp-section">
  <div class="c">
    <div class="dp-ct">
      <div class="dp-text rv">
        <div class="sg">What you are selling</div>
        <h2>Dual Pricing: The Easiest Sale in Merchant Services</h2>
        <p><strong>The pitch:</strong> "What if you could eliminate 100% of your credit card processing fees, legally, with no contract and free equipment?"</p>
        <p>The card price covers the processing fee. The cash price is the merchant's real price. Customers choose. The merchant keeps everything. It sells itself.</p>
        <p>The average dual pricing merchant generates <strong style="color:var(--teal)">$419.71 a month in residuals for you.</strong> That is not a commission. It is recurring income.</p>
      </div>
      <div class="dp-img rv d1"><img src="/images/dualprice.jpg" alt="Dual pricing receipt comparison showing card price and cash price" loading="lazy"></div>
    </div>
  </div>
</section>

<section style="background:var(--navy);padding:48px 0;text-align:center">
  <div class="c">
    <h2 class="rv" style="font-family:var(--fd);font-weight:800;font-size:1.4rem;color:#fff;margin-bottom:8px">This Is Not a Get-Rich-Quick Scheme.</h2>
    <p class="rv d1" style="color:rgba(255,255,255,.8);font-size:1rem;max-width:560px;margin:0 auto 6px">It is a build-now, get-paid-for-years business. Agents who show up consistently, learn the products and work their territory build portfolios that pay $5K, $10K, $20K and more per month. The ones who do not show up, do not.</p>
    <p class="rv d2" style="color:var(--gold);font-family:var(--fd);font-weight:700;font-size:.95rem">The opportunity is real. The question is whether you are.</p>
  </div>
</section>

<section class="apply" id="apply">
  <div class="c">
    <div class="apply-ct">
      <h2 class="rv">Apply to become an agent</h2>
      <p class="apply-sub rv d1">If we think you are a fit, we schedule a call within 24 hours.</p>
      <form class="form rv d2" method="POST" action={site.formEndpoint || '#'} data-form="agent" data-endpoint={site.formEndpoint || ''}>
        <input type="hidden" name="form" value="agent">
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" style="display:none">
        <div class="row"><div><label for="a-first">First name</label><input id="a-first" name="firstName" required></div><div><label for="a-last">Last name</label><input id="a-last" name="lastName" required></div></div>
        <div class="row"><div><label for="a-email">Email</label><input id="a-email" name="email" type="email" required></div><div><label for="a-phone">Phone</label><input id="a-phone" name="phone" type="tel" required></div></div>
        <div class="row"><div><label for="a-city">City</label><input id="a-city" name="city"></div><div><label for="a-state">State</label><input id="a-state" name="state"></div></div>
        <div class="row" style="grid-template-columns:1fr"><div><label for="a-exp">Do you have sales experience?</label>
          <select id="a-exp" name="experience"><option value="">Select one</option><option>No experience (that is okay)</option><option>Some sales experience</option><option>Experienced sales professional</option><option>Currently in merchant services</option></select></div></div>
        <div class="row" style="grid-template-columns:1fr"><div><label for="a-why">Why do you want to join Nextdoor Payments?</label><textarea id="a-why" name="why" rows="4" placeholder="Tell us a bit about yourself and what you are looking for."></textarea></div></div>
        <button type="submit" class="bp big" style="width:100%">Submit my application &rarr;</button>
        <p class="fine" style="text-align:center">No commitment. No fees. Questions? Call <a href={tel} style="color:var(--teal);font-weight:700">{site.phoneDisplay}</a>.</p>
        <div class="ok" role="status">Application received. We review it and reach out within 24 hours. In the meantime, feel free to call <a href={tel} style="color:var(--teal);font-weight:700">{site.phoneDisplay}</a>.</div>
      </form>
    </div>
  </div>
</section>

<script define:vars={{ smsBase: `sms:${site.phoneE164}` }}>
  const s = document.getElementById('merchSlider');
  const upd = () => {
    const n = Number(s.value); const m = n * 419.71;
    document.getElementById('merchCount').textContent = n + ' merchant' + (n > 1 ? 's' : '');
    document.getElementById('monthlyIncome').textContent = '$' + m.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    document.getElementById('yearlyIncome').textContent = '$' + (m * 12).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' / year';
  };
  s.addEventListener('input', upd);
  document.querySelectorAll('form[data-form="agent"]').forEach((f) => {
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(f); const endpoint = f.dataset.endpoint;
      window.dataLayer = window.dataLayer || []; window.dataLayer.push({ event: 'lead_submit', form: 'agent' });
      if (typeof gtag === 'function') gtag('event', 'generate_lead', { form: 'agent' });
      if (endpoint) { try { const r = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } }); if (r.ok) { f.querySelectorAll('.row,button,.fine').forEach((el) => (el.style.display = 'none')); f.querySelector('.ok').style.display = 'block'; return; } } catch (_) {} }
      const body = `Agent application: ${data.get('firstName')} ${data.get('lastName')}, ${data.get('city')} ${data.get('state')}, ${data.get('phone')}, ${data.get('email')}. Experience: ${data.get('experience')}. ${data.get('why')}`;
      window.location.href = smsBase + '?&body=' + encodeURIComponent(body);
    });
  });
</script>
</Layout>
