---
import Layout from '../layouts/Layout.astro';
import HubList from '../components/HubList.astro';
import CallCta from '../components/CallCta.astro';
import Faq from '../components/Faq.astro';
import PhoneIcon from '../components/PhoneIcon.astro';
import { site, tel, sms } from '../config';
const smsBody = 'Hi, I want to compare my gateway fees.';
const faq = [
  { q: 'What is the difference between a payment gateway and a payment processor?', a: 'The gateway is the software that securely captures the card and sends it for authorization: Authorize.net, NMI and accept.blue are gateways. The processor and acquiring bank move the money and set the interchange-plus-markup pricing. Most merchants pay both a gateway fee and processing fees, often to two different companies. We supply both, so there is one bill and one phone number.' },
  { q: 'Can I keep my shopping cart or software if I switch gateways?', a: 'Almost always. WooCommerce, Shopify, Ecwid, OpenCart, Volusion, QuickBooks and most SaaS billing tools support multiple gateways. Switching is a matter of installing the new plugin or entering new API keys. We do it with you on a call.' },
  { q: 'Do I lose my stored customer cards when I leave Authorize.net?', a: 'Not necessarily. Authorize.net will export stored customer payment profiles to another PCI-compliant gateway on request. The export is PGP-encrypted, runs on a schedule, and there may be a fee for CIM or ARB data. We coordinate the migration so recurring customers do not have to re-enter cards.' },
  { q: 'What does accept.blue cost?', a: 'accept.blue is sold through partners like us rather than directly, so pricing is set per merchant. Ask for a written quote that shows the gateway monthly fee, per-transaction fee and processing markup on one page. That is the only way to compare it fairly against your current Authorize.net bill.' },
];
const schema = [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }];
---
<Layout title="Payment Gateways: Authorize.net Alternatives, Fees and Switching" description={`Compare Authorize.net, NMI and accept.blue gateway fees. Keep your cart, QuickBooks or software, cut the monthly gateway bill, and migrate stored cards safely. Call ${site.phoneDisplay}.`} schema={schema} smsBody={smsBody}>
  <section class="phero"><div class="c">
    <div class="sg">Payment gateways</div>
    <h1>Payment Gateways for Businesses That Already Have Software</h1>
    <p class="lead">You built your store, your billing, or your QuickBooks workflow around a gateway years ago. You should not have to rebuild it to stop overpaying. We connect accept.blue and other gateways to what you already run, migrate stored cards, and put gateway plus processing on one bill.</p>
    <div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:20px">
      <a href={tel} class="bp big" data-cta="gw-call"><PhoneIcon />Call {site.phoneDisplay}</a>
      <a href="/gateways/switch-from-authorize-net" class="bo">Leaving Authorize.net? Start here</a>
    </div>
  </div></section>
  <section class="sec"><div class="c">
    <div class="sh"><div class="sg">Guides</div><h2>Gateway Fees, Alternatives and Migration</h2></div>
    <HubList category="gateways" />
  </div></section>
  <section class="sec alt"><div class="c">
    <div class="sh"><div class="sg">QuickBooks</div><h2>Invoicing and QuickBooks Payments</h2></div>
    <HubList category="quickbooks" />
  </div></section>
  <section class="sec"><div class="c" style="max-width:860px">
    <CallCta heading="Send your gateway and processing statements together" body="Gateway fees hide on a separate invoice from processing fees. Send both. We total them, show your true all-in cost per transaction, and quote one number to beat." smsBody={smsBody} />
    <Faq items={faq} />
  </div></section>
</Layout>
