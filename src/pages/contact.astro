---
import Layout from '../layouts/Layout.astro';
import LeadForm from '../components/LeadForm.astro';
import PhoneIcon from '../components/PhoneIcon.astro';
import { site, tel, sms } from '../config';
const schema = [{ '@context': 'https://schema.org', '@type': 'ContactPage', mainEntity: { '@id': `${site.url}/#organization` } }];
---
<Layout title="Contact Nextdoor Payments" description={`Call or text ${site.phoneDisplay}. Merchant services, Clover POS, dual pricing and payment gateways for San Diego, Los Angeles and businesses nationwide. ${site.hours}`} schema={schema}>
  <section class="phero"><div class="c">
    <div class="sg">Contact</div>
    <h1>Talk to a Person, Not a Phone Tree</h1>
    <p class="lead">Owner-operated. Text is usually fastest. If we miss a call we text back within the hour during business hours.</p>
  </div></section>
  <section class="sec"><div class="c art-grid">
    <div class="prose">
      <h2>Phone and text</h2>
      <p><a href={tel} data-cta="contact-call" style="font-family:var(--fd);font-weight:900;font-size:1.8rem;text-decoration:none">{site.phoneDisplay}</a><br>{site.hours}</p>
      <p><a href={tel} class="bp" data-cta="contact-call2"><PhoneIcon />Call now</a> &nbsp; <a href={sms('Hi, I have a question about payment processing.')} class="bo" data-cta="contact-text">Send a text</a></p>
      <h2>Email</h2>
      <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
      <h2>Where to start</h2>
      <p>Most conversations start with the <a href="/free-statement-analysis">free statement analysis</a>. If you already know what you need: <a href="/clover">Clover POS</a>, <a href="/gateways">payment gateways</a>, <a href="/dual-pricing">dual pricing</a>, or your <a href="/industries">industry</a>.</p>
      <h2>Service area</h2>
      <p>In-person installs and support across San Diego County, Los Angeles County, Orange County, the Inland Empire and Temecula Valley. Shipped, pre-programmed hardware with phone setup for Ventura County, Santa Barbara, Kern County and the Coachella Valley, and for businesses anywhere in the United States. The full list is on the <a href="/locations">service area page</a>.</p>
      <h2>About Nextdoor Payments</h2>
      <p>Nextdoor Payments is an independent merchant services provider founded by <a href={site.founderUrl}>{site.founderName}</a>, who has spent more than 21 years in payments and boarded over 2,000 merchants. We set up dual pricing credit card processing, Clover and Dejavoo hardware, Exatouch and TableTurn point of sale, the accept.blue payment gateway, and Hyfin invoicing synced to QuickBooks. Agreements are month to month. Equipment is placed through free-equipment programs where the merchant qualifies. We publish current pricing for the products we sell and we tell you when a competitor's offer is better than ours.</p>
    </div>
    <aside class="side"><LeadForm kind="contact" title="Send us a message" submitLabel="Send message" /></aside>
  </div></section>
</Layout>
