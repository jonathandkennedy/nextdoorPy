---
import Layout from '../layouts/Layout.astro';
import HubList from '../components/HubList.astro';
import CallCta from '../components/CallCta.astro';
import Faq from '../components/Faq.astro';
import Tldr from '../components/Tldr.astro';
import PhoneIcon from '../components/PhoneIcon.astro';
import { site, tel, sms } from '../config';
const smsBody = 'Hi, I am interested in Clover POS pricing.';
const faq = [
  { q: 'Is Clover cheaper from a dealer or from clover.com?', a: 'Usually cheaper from a dealer, if the dealer publishes its terms. Clover.com sells hardware at list price with a fixed 2.3% + 10¢ in-person rate on most plans. A dealer sets its own processing pricing, can place hardware through a free-equipment program, and can run dual pricing so your processing cost goes to zero. The risk with dealers is undisclosed contracts and leases, which is why we put everything in writing before you sign.' },
  { q: 'Which Clover should I get?', a: 'Station Duo for restaurants, bars and barcode retail where customers face the counter. Mini for single-register cafes, salons, small retail and service desks. Flex for pay at table, curbside and mobile businesses. Kiosk for quick service with lines. Compact when you only need a terminal. Our device comparison pages walk through each choice.' },
  { q: 'Can I run dual pricing on Clover?', a: 'Yes. Clover supports dual pricing through the processor configuration. The card price and cash price display on the customer-facing screen and print on the receipt, which is what the card brands require. It applies to credit and debit alike and takes the merchant’s processing cost to zero.' },
  { q: 'Do you require a contract or a lease for Clover?', a: 'No long-term processing contract. Hardware is placed through a free-equipment program for qualifying merchants, or purchased outright. We do not do leases.' },
  { q: 'Can you reprogram a Clover I already own?', a: 'Sometimes. Clover devices are tied to the merchant account they were boarded on. If the original dealer releases the device and it is a supported generation, it can be re-boarded; otherwise a placement replaces it at no charge. Text the serial number and we will check.' },
  { q: 'Does Clover work with QuickBooks?', a: 'Through App Market connectors such as Commerce Sync, which posts a daily sales summary to QuickBooks Online or Desktop. Item-level sync needs a connector that supports it. We set it up with your bookkeeper on install.' },
];
const schema = [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'Service', name: 'Clover POS sales, setup and processing', serviceType: 'Point of sale system installation and merchant services', provider: { '@id': `${site.url}/#organization` }, areaServed: site.areaServed, description: 'Clover Station Duo, Station Solo, Mini, Flex, Compact, Kiosk and Go with dealer pricing, dual pricing configuration, menu and inventory setup, staff training and local support.' },
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Clover POS', url: `${site.url}/clover`, about: 'Clover point of sale devices, pricing, comparisons, industry setups and operations' }];
const devices = [
  { name: 'Station Duo', href: '/clover/station-duo', screen: '14" + 8" customer', printer: 'Built in', drawer: 'Included', mobile: 'No', list: '$1,899', fit: 'Restaurants, bars, barcode retail' },
  { name: 'Station Solo', href: '/clover/station-solo', screen: '14" single', printer: 'Built in', drawer: 'Included', mobile: 'No', list: '$1,799', fit: 'Staff-only stations, pair with Flex' },
  { name: 'Mini', href: '/clover/mini', screen: '8" single', printer: 'Built in', drawer: 'Via hub', mobile: 'No (LTE)', list: '$849', fit: 'Cafes, salons, small retail, second lane' },
  { name: 'Flex', href: '/clover/flex', screen: '5.99" handheld', printer: 'Built in', drawer: 'No', mobile: 'Yes, LTE, 8h battery', list: '$699 to $749', fit: 'Pay at table, curbside, mobile' },
  { name: 'Kiosk', href: '/clover/kiosk', screen: '24" + 8" payment', printer: 'Built in', drawer: 'No', mobile: 'No', list: 'About $3,599 + $34.95/mo', fit: 'Quick service self-order' },
  { name: 'Compact', href: '/clover/compact', screen: '3.6" terminal', printer: 'Built in', drawer: 'No', mobile: 'Optional LTE', list: 'Dealer', fit: 'Payments only, offices, second point' },
  { name: 'Go', href: '/clover/go', screen: 'Phone app', printer: 'No', drawer: 'No', mobile: 'Via phone', list: '$49 to $199', fit: 'Occasional mobile sales' },
];
const deviceIds = ['clover/station-duo', 'clover/station-solo', 'clover/mini', 'clover/flex', 'clover/kiosk', 'clover/compact', 'clover/go'];
const compareIds = ['clover/station-duo-vs-solo', 'clover/flex-vs-mini', 'clover/vs-square', 'clover/vs-toast', 'clover/reseller-vs-direct'];
const priceIds = ['clover/pricing', 'clover/dual-pricing', 'clover/reviews', 'clover/used-clover-and-reprogramming'];
const industryIds = ['clover/for-restaurants', 'clover/for-quick-service', 'clover/for-bars', 'clover/for-coffee-shops', 'clover/for-retail', 'clover/for-salons', 'clover/for-food-trucks'];
const opsIds = ['clover/setup-and-training', 'clover/offline-mode', 'clover/online-ordering', 'clover/gift-cards-and-loyalty', 'clover/quickbooks-integration'];
---
<Layout title="Clover POS: Devices, Pricing, Comparisons and Setup From a Local Dealer" description={`Every Clover device compared, dealer vs clover.com pricing, dual pricing to eliminate processing fees, setups for restaurants, bars, cafes, retail and salons, and the operational answers. Local installs in San Diego and LA. Call ${site.phoneDisplay}.`} schema={schema} smsBody={smsBody}>
  <section class="phero"><div class="c">
    <div class="sg">Clover POS</div>
    <h1>Clover POS With Dealer Pricing, Dual Pricing and a Local Installer</h1>
    <p class="lead">Same Clover hardware and software you see on clover.com. Different economics: dual pricing takes your processing cost to zero, hardware is placed through a free-equipment program where you qualify, and setup is done by us in person or over the phone instead of a ticket queue. Below: every device, every comparison, every business type, and the questions that come up after install.</p>
    <div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:20px">
      <a href={tel} class="bp big" data-cta="clover-call"><PhoneIcon />Call {site.phoneDisplay}</a>
      <a href={sms(smsBody)} class="bo" data-cta="clover-text">Text for a Clover quote</a>
    </div>
  </div></section>

  <section class="sec"><div class="c" style="max-width:860px">
    <Tldr label="The short version" items={[
      'Clover is sold direct by Fiserv at list price with a fixed 2.3% + 10¢ in-person rate, and by dealers who set their own terms. The hardware and software are identical. The processing behind it is the whole cost difference: on $40,000 a month it is about $1,000 a month.',
      'Pick the device by how the customer pays you: Station Duo where customers face a counter, Mini for a single small register, Flex when you go to the customer, Kiosk when lines form. All run the same software.',
      'Our terms: hardware placed at no charge for qualifying merchants, never leased; month-to-month processing under dual pricing ($0 to you) or interchange-plus; menu built and staff trained before you go live.',
    ]} />
  </div></section>

  <section class="sec alt"><div class="c">
    <div class="sh"><div class="sg">Devices</div><h2>Every Clover, Compared</h2><p>List prices are clover.com's as of September 2026. Through us, all of them are placed at no charge for qualifying merchants.</p></div>
    <div class="prose" style="max-width:none">
      <table>
        <thead><tr><th>Device</th><th>Screen</th><th>Printer</th><th>Cash drawer</th><th>Mobile</th><th>List price</th><th>Best for</th></tr></thead>
        <tbody>{devices.map((d) => <tr><td><a href={d.href}><strong>{d.name}</strong></a></td><td>{d.screen}</td><td>{d.printer}</td><td>{d.drawer}</td><td>{d.mobile}</td><td>{d.list}</td><td>{d.fit}</td></tr>)}</tbody>
      </table>
    </div>
    <div style="margin-top:24px"><HubList ids={deviceIds} /></div>
  </div></section>

  <section class="sec"><div class="c">
    <div class="sh"><div class="sg">Which one</div><h2>Comparisons: Duo vs Solo, Flex vs Mini, Clover vs Square, Clover vs Toast</h2></div>
    <HubList ids={compareIds} />
  </div></section>

  <section class="sec alt"><div class="c">
    <div class="sh"><div class="sg">Pricing and terms</div><h2>What Clover Costs, Dual Pricing, Reviews, and the Locked-Device Problem</h2></div>
    <HubList ids={priceIds} />
  </div></section>

  <section class="sec"><div class="c">
    <div class="sh"><div class="sg">By business</div><h2>Clover Setups by Business Type</h2><p>The devices, plan, menu design and dual pricing math for each.</p></div>
    <HubList ids={industryIds} />
  </div></section>

  <section class="sec alt"><div class="c">
    <div class="sh"><div class="sg">Running it</div><h2>Setup, Outages, Online Ordering, Gift Cards, QuickBooks</h2></div>
    <HubList ids={opsIds} />
  </div></section>

  <section class="sec"><div class="c" style="max-width:860px">
    <div class="prose">
      <h2>What you get from us that you do not get from clover.com</h2>
      <table>
        <thead><tr><th>Item</th><th>clover.com direct</th><th>Nextdoor Payments</th></tr></thead>
        <tbody>
          <tr><td>In-person processing rate</td><td>2.3% + 10¢ (2.6% + 10¢ on Essentials)</td><td>Dual pricing: 0% to you. Or interchange-plus on request.</td></tr>
          <tr><td>Hardware</td><td>List price or 36-month payments</td><td>Free-equipment program for qualifying merchants, or buy outright. Never leased.</td></tr>
          <tr><td>Contract</td><td>No long-term processing contract</td><td>Month to month, in writing</td></tr>
          <tr><td>Menu and inventory setup</td><td>Self-serve</td><td>Done for you before install day</td></tr>
          <tr><td>Support</td><td>Clover phone and chat</td><td>Us first, then Clover. Same-day fixes in San Diego and LA.</td></tr>
        </tbody>
      </table>
      <p>Clover is sold through Fiserv and a network of independent dealers. Prices and rates on clover.com are Fiserv's direct offer and change without notice. Our comparison is current as of the date on each guide. When a direct deal is better for you, we say so.</p>
    </div>
    <CallCta heading="Get a Clover quote with the real numbers" body="Tell us your business type and monthly card volume. You get hardware options, monthly software cost and your processing cost under dual pricing, in writing, usually the same day." smsBody={smsBody} />
    <Faq items={faq} />
  </div></section>
</Layout>
