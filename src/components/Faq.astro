---
export interface Item { q: string; a: string }
const { items = [] as Item[], heading = 'Frequently asked questions' } = Astro.props;
---
{items.length > 0 && (
  <section class="faq" id="faq">
    <h2>{heading}</h2>
    {items.map((it) => (
      <details>
        <summary>{it.q}</summary>
        <div class="a" set:html={it.a} />
      </details>
    ))}
  </section>
)}
