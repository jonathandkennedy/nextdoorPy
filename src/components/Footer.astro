---
import { site, tel, sms } from '../config';
const year = new Date().getFullYear();
---
<footer class="ft">
  <div class="c">
    <div class="ftg">
      <div class="ftb">
        <img src="/images/logo.png" alt="Nextdoor Payments" width="142" height="32">
        <p>Local merchant services for California businesses. Dual pricing, Clover POS, payment gateways and QuickBooks invoicing. No contracts. A real person answers the phone.</p>
        <p><strong>Call or text:</strong> <a href={tel} data-cta="footer" style="color:var(--teal);font-weight:700">{site.phoneDisplay}</a><br>{site.hours}</p>
      </div>
      <div class="ftc"><h4>Clover POS</h4><ul>
        <li><a href="/clover">Clover POS from a local dealer</a></li>
        <li><a href="/clover/pricing">Clover pricing and fees</a></li>
        <li><a href="/clover/dual-pricing">Dual pricing on Clover</a></li>
        <li><a href="/clover/reseller-vs-direct">Clover reseller vs buying direct</a></li>
        <li><a href="/clover/station-duo">Clover Station Duo</a></li>
        <li><a href="/clover/flex">Clover Flex</a></li>
        <li><a href="/clover/vs-square">Clover vs Square</a></li>
        <li><a href="/clover/for-restaurants">Clover for restaurants</a></li>
      </ul></div>
      <div class="ftc"><h4>Gateways &amp; software</h4><ul>
        <li><a href="/gateways">Payment gateways</a></li>
        <li><a href="/gateways/authorize-net-alternatives">Authorize.net alternatives</a></li>
        <li><a href="/gateways/authorize-net-fees">Authorize.net fees explained</a></li>
        <li><a href="/gateways/switch-from-authorize-net">Switch from Authorize.net</a></li>
        <li><a href="/gateways/pricing">Gateway pricing compared</a></li>
        <li><a href="/gateways/nmi">NMI gateway</a></li>
        <li><a href="/quickbooks/credit-card-processing-fees">QuickBooks processing fees</a></li>
      </ul></div>
      <div class="ftc"><h4>Company</h4><ul>
        <li><a href="/dual-pricing">Dual pricing explained</a></li>
        <li><a href="/industries">Industries we serve</a></li>
        <li><a href="/free-statement-analysis">Free statement analysis</a></li>
        <li><a href="/opportunity">Become an agent</a></li>
        <li><a href="/about/jonathan-kennedy">About Jonathan Kennedy</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul></div>
    </div>
    <div class="fbt">
      <p>&copy; {year} {site.legalName}. Serving San Diego, Los Angeles and businesses nationwide.</p>
      <a href={tel} data-cta="footer-bottom">{site.phoneDisplay}</a>
    </div>
  </div>
</footer>
